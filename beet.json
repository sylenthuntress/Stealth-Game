{
    "name": "Hide & Squeak",
    "description": "meow",
    "author": "SylentHuntress",
    "require": [
        "bolt",
        "bolt_expressions"
    ],
    "data_pack": {
        "load": [ "src" ],
        "name": "Hide & Squeak",
        "max_format": 121,
        "min_format": 121,
        "filter": {
            "block": [
                {
                    "namespace": "^minecraft$",
                    "path": "^recipe/.*$"
                },
                {
                    "namespace": "^minecraft$",
                    "path": "^advancement/.*$"
                }
            ]
        }
    },
    "resource_pack": {
        "load": [ "src" ],
        "name": "Hide & Squeak (Assets)",
        "min_format": 97,
        "max_format": 97
    },
    "pipeline": [ "mecha" ],
    "output": "build",
    "meta": {
        "bolt": {
            "entrypoint": ["menu:credits", "menu:guidebook"]
        },
        "bolt_expressions": {
            "init_path": "setup:math",
            "const_objective": "math.const",
            "const_score_prefix": "#",
            "temp_objective": "math.const",
            "temp_score_prefix": "#"
        }
    }
}