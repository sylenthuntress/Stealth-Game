from menu:builder import TextBuilder

dialogs = []
class DialogBuilder:
    def __init__(self, id):
        self._id = f"menu:{id}"
        self._title = {"translate": f"menu.{id}".replace("/", ".")}
        self._exit = {
            "label": {
                "translate": "menu.close"
            }
        }
        self._actions = []
        self._body = []
        self._columns = 3
        self._index = len(dialogs) + 1
        self._guidebook = false

    def translate_title(self, translation):
        translation = {self._title.get("translate"): translation}
        merge language menu:en_us {**translation}
        return self

    def page(self, dialog):
        value = 0
        global dialogs
        for index in range(len(dialogs)):
            entry = dialogs[index]
            if entry.get("id") == f"menu:{dialog}":
                value = entry.get("index")
                break
        if value == 0:
            value += len(dialogs) + 2
            dialogs.append({"index": value, "id": f"menu:{dialog}", "dialog": {}})
        self._actions.append({
            "label": {
                "translate": f"menu.{dialog}".replace("/", "."),
                "color": "white"
            },
            "action": {
                "type": "minecraft:run_command",
                "command": f"trigger menu.guidebook.selected_page set {value}"
            }
        })
        return self

    def prev(self, dialog):
        value = 1
        global dialogs
        for entry in dialogs:
            if entry.get("id") == f"menu:{dialog}":
                value = entry.get("index")
        self._exit = {
            "label": {
                "translate": f"menu.{dialog}".replace("/", "."),
                "color": "white"
            },
            "action": {
                "type": "minecraft:run_command",
                "command": f"trigger menu.guidebook.selected_page set {value}"
            }
        }
        return self

    def columns(self, columns):
        self._columns = columns
        return self

    def line(self, text):
        self._body.append ({
            "type": "minecraft:plain_message",
            "width": 300,
            "contents": [
                text
            ]
        })
        return self

    def line_item(self, description, item):
        self._body.append({
            "type": "minecraft:item",
            "description": description,
            "show_tooltip": false,
            "item": item
        })

        return self

    def build(self):
        global dialogs
        if not self._actions:
            for entry in dialogs:
                parent_dialog = entry.get("dialog")
                if parent_dialog and parent_dialog.get("title").get("translate") == self._exit.get("label").get("translate"):
                    for page in entry.get("dialog").get("actions"):
                        if page.get("label").get("translate") != self._title.translate:
                            self._actions.append(page)
                    break   

        dialog = {
            "type": "minecraft:multi_action",
            "pause": false,
            "after_action": "close",
            "title": self._title,
            "actions": self._actions,
            "body": self._body,
            "exit_action": self._exit
        }

        index = self._index
        for entry in dialogs:
            if entry.get("id") == self._id:
                index = entry.get("index")
                dialogs.remove(entry)
                break
        return_value = {"id": self._id, "dialog": dialog, "index": index}
        dialogs.append(return_value)
        return return_value

pages = []

# Main Guidebook
pages.append(DialogBuilder("guidebook/intro")
    .translate_title("Guidebook")
    .line(TextBuilder("menu.guidebook.1")
        .translate("Welcome to Hide & Squeak! H&S is an asymmetrical game of Cat & Mouse. To summarize, it's a very silly game where the Runners must try and reach the end of a randomly-generated map without getting caught by the deadly Hunters.")
        .color("gray")
        .build())
    .columns(4)
    .page("guidebook/core_gameplay")
    .page("guidebook/runners")
    .page("guidebook/killers")
    .build())

# Core Gameplay
