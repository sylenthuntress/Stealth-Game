class TextBuilder:
    _string: str

    def __add_credit__(name, role):
        credits.append(
            {
                "type": "minecraft:plain_message",
                "contents": {
                    "translate": "menu.credits.credit",
                    "with": [name, role]
                }
            }
        )

    ## This becomes "text", or the translation key if using translate()
    def __init__(self, string):
        self._string = string
        self._bold = false
        self._color = "white"
        self._with = []
        self._translate = false

    def color(self, color: str):
        self._color = color
        return self
    
    def bold(self):
        self._bold = true
        return self

    def translated(self):
        self._translate = true
        return self
    
    def translate(self, translation):
        translation = {self._string: translation}
        merge language menu:en_us {**translation}
        return self.translated()

    def with_text(self, text):
        self._with.append(text)
        return self

    def build(self):
        string = {"text": self._string}
        if self._translate:
            string = {"translate": self._string}

        Text = {
            **string,
            "color": self._color,
            "bold": self._bold,
            "with": self._with
        }
        return Text