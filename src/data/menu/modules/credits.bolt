import yaml
from util:builders import TextBuilder

def make_body(text):
    return {
        "type": "minecraft:plain_message",
        "width": 250,
        "contents": text
    }

main_credits = []
def add_main_credit(name, role):
    main_credits.append(
        {
            "type": "minecraft:plain_message",
            "width": 250,
            "contents": {
                "translate": "menu.credits.credit",
                "color": "dark_gray",
                "with": [name, role]
            }
        }
    )


add_main_credit(TextBuilder("SylentHuntress")
    .color("dark_green")
    .bold()
    .build(), TextBuilder("Creator")
    .color("green")
    .bold()
    .build())

add_main_credit(TextBuilder("Command Realm")
    .color("dark_aqua")
    .bold()
    .build(), TextBuilder("Creators of Stealthiators; the original inspiration.")
    .color("aqua")
    .build())

body = main_credits
with open('./credits.yml', 'r') as file:
    credits = yaml.full_load(file)
    for category in credits.values():
        contents = []
        if isinstance(category, list):
            first = true
            for credit in category:
                title = credit.get("text")
                if not first:
                    title = "\n\n" + title

                names = credit.get("names")
                text = ""
                first = false
                if names:
                    for name in names:
                       text = text + "\n " + name
                contents.append([
                    {
                        "text": title, 
                        "color": credit.get("color"),
                        "bold": true
                    },
                    {
                        "text": text, 
                        "color": "gray",
                        "bold": false
                    }
                ])
            body.append(make_body(contents))
        else:
            title = category.get("text") + "\n"
            names = category.get("names")

            text = ""
            first = true
            for name in names:
                if not first:
                    text = text + "\n "
                first = false
                text = text + name
            contents = [
                {
                    "text": "" + title, 
                    "color": category.get("color"),
                    "bold": true
                },
                {
                    "text": text, 
                    "color": "gray",
                    "bold": false
                }
            ]
            body.append(make_body(contents))

dialog = {
  "type": "minecraft:multi_action",
  "title": {
    "translate": "menu.credits"
  },
  "body": body,
  "columns": 3,
  "pause": false,
  "actions": [
    {
      "label": {
        "translate": "menu.credits.projects_discord",
        "color": "blue",
        "underlined": true
      },
        "action": {
          "type": "open_url",
          "url": "https://discord.gg/gYWwjRfNH7"
        }
    },
    {
      "label": {
        "translate": "menu.credits.game_discord",
        "color": "blue",
        "underlined": true
      },
        "action": {
          "type": "open_url",
          "url": "https://discord.gg/RSzekrTsys"
        },
        "width": 100
    },
    {
      "label": {
        "translate": "menu.credits.stealthiators",
        "color": "blue",
        "underlined": true
      },
        "action": {
          "type": "open_url",
          "url": "https://www.planetminecraft.com/project/stealthiators"
        }
    }
  ]
}
function menu:open_credits:
    dialog show @s dialog