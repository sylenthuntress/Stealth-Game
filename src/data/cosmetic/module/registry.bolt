    .custom_icon("minecraft:item/stick", "minecraft:items")
    .rarity(Rarity.COMMON)
    .default()
    .desc(TextBuilder("cosmetic.killer_skin.hunter.desc")
        .translate("LOREM IPSUM DOLOR")
        .color("gray")
        .italic()
        .build())
    .build())
(killer_skin("warden")
