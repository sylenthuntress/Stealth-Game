from util:builders import TextBuilder
from enum import Enum

class Rarity(Enum):
    name: str
    color: str
    def rarity(name, color):
        return {"name": name, "color": color}

    COMMON = rarity("Common", "gray")
    UNCOMMON = rarity("Uncommon", "light_green")
    RARE = rarity("Rare", "blue")
    EPIC = rarity("Epic", "#964bad")

cosmetics = []
class Cosmetic():
    def getCosmetic(name):
        for cosmetic in cosmetics:
            if cosmetic.identifier == name:
                return cosmetic
        return cosmetics[0]

    def __init__(self, nbt):
        self.identifier = nbt.id
        self._numid = nbt.numid
        self._title = nbt.title
        self._desc = nbt.desc
        self._type = nbt.type
        self._icon = nbt.icon
        self._width = nbt.width
        self._components = nbt.components

    def get_equipment(self):
        equipment = {}
        for entry in self._components.get("cosmetic:equipment"):
            slot = entry.slot.replace("armor.", "")
            if not (slot == "head" or slot == "chest" or slot == "legs" or slot == "feet"):
                break
            equipment.update({slot: {"id": entry.id, "count": 1, "components": entry.components}})
        return equipment

    def get_name(self):
        name = self._title
        name.update({"with": [self._icon]})
        return name

numid_index = 0
class CosmeticsBuilder():
    def __init__(self, identifier, registry):
        self._identifier = identifier
        global numid_index
        numid_index += 1
        self._numid = numid_index
        self._title = {"translate": identifier, "color": "white"}
        self._desc = [{"translate": identifier},"\n",{"translate": identifier+".desc"}]
        self._type = registry
        self._icon = {}
        self._player = {}
        self._width = 120
        self._equipment_layers = {}
        self._components = {}

    def translate_title(self, translation):
        translation = {self._title.get("translate"): f"%s {translation}"}
        merge language cosmetic:en_us {**translation}
        return self

    def desc(self, text):
        title = self._title.copy()
        title.update({"with": [self._icon]})
        self._desc = [title,"\n",text]
        return self

    def player(self, texture):
        self._player = {"texture": texture}
        self._icon = {"object": "player", "player": {"texture": texture+"/head"}, "color": "white"}
        return self

    def custom_icon(self, sprite, atlas):
        self._icon = {"object": "atlas", "sprite": sprite, "atlas": atlas, "color": "white"}
        return self

    def rarity(self, rarity : Rarity):
        self._components.update({"cosmetic:rarity": rarity})
        self._title.update({"color": rarity.value.color})
        return self

    def unlockable(self, advancement_id=""):
        if advancement_id == "":
            advancement_id = self._identifier.replace(".", ":unlock/", 1).replace(".", "/")
            advancement advancement_id {
                "criteria": {
                    "conditions": {
                        "trigger": "minecraft:impossible"
                    }
                }
            }
        self._components.setdefault("cosmetic:unlockable", {
            "desc": [
                TextBuilder(self._identifier+".locked")
                .translate("Locked: %s")
                .color("red")
                .with_text(TextBuilder(self._identifier+".desc.locked")
                    .translate("Currently unobtainable.")
                    .color("gray")
                    .build())
                .bold()
                .build(),
                "\n\n"
            ], 
            "advancements": []}).get("advancements").append(advancement_id)
        return self

    def unlockable_desc(self, text):
        self._components.get("cosmetic:unlockable").update({"desc": [text,"\n\n"]})
        return self

    def secret(self):
        self._components.update({"cosmetic:secret": true})
        return self

    def equipment(self, slot, item, components):
        self._components.setdefault("cosmetic:equipment", []).append({"slot": slot, "id": item, "components": components})
        return self

    def add_layer(self, layer, texture = ""):
        if not texture:
            texture = self._identifier.replace("cosmetic.", "hide_and_squeak:cosmetic/", 1).replace(".", "/")
        self._equipment_layers.update({layer: [{"texture": texture}]})
        return self

    def equip_player_head(self, texture = ""):
        profile = self._player.copy()
        if texture.startswith("/"):
            profile.update({"texture": profile.get("texture") + texture})
        components = {"enchantment_glint_override":false,"enchantments":{"binding_curse":1,"vanishing_curse":1},"tooltip_display":{"hide_tooltip":false,"hidden_components":["enchantments","attribute_modifiers"]}}
        components.update({"profile":profile})
        components.update({"equippable":{"slot":"head","equip_sound":"block.sand.step"}})

        item_name = self._title.copy()
        item_name.update({"with": [{"player": profile, "color": "white"}]})
        item_name.update({"italic": false})
        components.update({"custom_name":item_name})
        
        return self.equipment("armor.head", "minecraft:player_head", components)

    def armor_item(self, slot, item_model, name_icon = ""):
        import re
        from beet import Context, Texture
        from PIL import Image
        components = {"item_model":item_model,"equippable":{"slot":slot,"equip_sound":"block.sand.step","damage_on_hurt":false},"enchantment_glint_override":false,"enchantments":{"binding_curse":1,"vanishing_curse":1},"tooltip_display":{"hide_tooltip":false,"hidden_components":["enchantments","attribute_modifiers"]}}

        # Item name
        if not name_icon:
            name_icon = item_model
        item_name = self._title.copy()
        item_name.update({"with": [{"color": "white", "sprite": name_icon, "atlas": "minecraft:items"}]})
        item_name.update({"italic": false})
        components.update({"custom_name":item_name})
        
        return self.equipment(f"armor.{slot}", "minecraft:coal", components)

    def armor(self, slot):
        import re
        from beet import Context, Texture
        from PIL import Image
        texture = self._identifier.replace("cosmetic.", "hide_and_squeak:cosmetic/", 1).replace(".", "/")
        item_texture = f"{texture}/{slot}"
        components = {"enchantment_glint_override":false,"enchantments":{"binding_curse":1,"vanishing_curse":1},"tooltip_display":{"hide_tooltip":false,"hidden_components":["enchantments","attribute_modifiers"]}}
        # Armor texture
        components.update({"equippable":{"slot":slot,"asset_id":texture,"equip_sound":"block.sand.step","damage_on_hurt":false}})
        
        # Item Model
        merge item_model item_texture {"model":{"type": "minecraft:model","model": item_texture.replace(":", ":item/")}}
        merge model item_texture.replace(":", ":item/") {"parent": "minecraft:item/generated","textures": {"layer0": item_texture.replace(":", ":item/")}}
        placeholder = Image.open(f"./src/assets/hide_and_squeak/textures/item/cosmetic/placeholder/{slot}.png")
        ctx.assets.textures.setdefault(item_texture.replace(":", ":item/"), Texture(placeholder))
        components.update({"item_model":item_texture})

        # Item name
        item_name = self._title.copy()
        item_name.update({"with": [{"sprite": item_texture.replace(":", ":item/"), "atlas": "minecraft:items", "color": "white"}]})
        item_name.update({"italic": false})
        components.update({"custom_name":item_name})
        
        return self.equipment(f"armor.{slot}", "minecraft:coal", components)

    def hiding_item(self, item = "minecraft:player_head", components = {}):
        if not components:
            if self._player:
                profile = self._player.copy()
                profile.update({"texture": profile.get("texture") + "/hiding"})
            else:
                profile = {"texture": self._identifier.replace("cosmetic.", "hide_and_squeak:entity/player/cosmetic/", 1).replace(".", "/") + "/hiding"}
            components.update({"profile":profile})
        components.update({"equippable":{"slot":"body","equip_sound":"block.sand.step","damage_on_hurt":false},"enchantment_glint_override":false,"enchantments":{"binding_curse":1,"vanishing_curse":1},"tooltip_display":{"hide_tooltip":false,"hidden_components":["enchantments","attribute_modifiers"]}})
        self._components.update({"cosmetic:hiding_form": {"type": "cosmetic:item", "id": item, "components": components}})
        return self

    def feature(self, text):
        self._components.setdefault("cosmetic:features", [
            {
                "text": "\n\nFeatures:",
                "color": "dark_gray",
                "bold": true
            }
        ]).append({"text": "\n• ","color":"dark_gray"})
        self._components.get("cosmetic:features").append(text)
        return self

    def default(self):
        self._components.update({"cosmetic:default": true})
        return self

    def width(self, width):
        self._width = width
        return self

    def build(self):
        rarity = self._components.get("cosmetic:rarity")
        self._desc = [TextBuilder("cosmetic.desc.rarity")
            .translate("Rarity: %s\n")
            .bold()
            .with_text(TextBuilder(rarity.value.name)
            .color(rarity.value.color)
            .build()).build(), self._desc]
        self._components.update({"cosmetic:rarity": rarity.name.lower()})

        if self._equipment_layers:
            equipment = self._identifier.replace("cosmetic.", "hide_and_squeak:cosmetic/", 1).replace(".", "/")
            merge equipment equipment: {
                "layers": self._equipment_layers
            }

        nbt = {
            "type": self._type,
            "id": self._identifier,
            "title": self._title,
            "numid": self._numid,
            "desc": self._desc,
            "icon": self._icon,
            "width": self._width,
            "components": self._components
        }
        append function setup:cosmetics:
            data modify storage cosmetic:data Registry append value nbt
                
        cosmetic = Cosmetic(nbt)
        cosmetics.append(cosmetic)
        return cosmetic
# Runner Skins
def runner_skin(name):
    name = "cosmetic.runner_skin." + name
    return CosmeticsBuilder(name, "cosmetic:runner/skin")
(runner_skin("field_mouse")
    .translate_title("Field Mouse")
    .player("hide_and_squeak:entity/player/cosmetic/runner_skin/field_mouse")
    .rarity(Rarity.COMMON)
    .default()
    .desc(TextBuilder("cosmetic.runner.skin.field_mouse.desc")
        .translate("Common field mouse. Naive hope illuminates its eyes, but a ruthless nature underlies it.")
        .color("gray")
        .italic()
        .build())
    .equip_player_head("/head")
    .armor("chest").add_layer("humanoid")
    .armor("legs").add_layer("humanoid_leggings")
    .armor("feet")
    .hiding_item()
    .build())
