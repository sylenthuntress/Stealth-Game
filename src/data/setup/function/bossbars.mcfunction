# Round Timer
bossbar add game:time/round_timer {"translate":"game.round_timer"}
bossbar set game:time/round_timer style notched_12
bossbar set game:time/round_timer visible true

# Endgame Timer
bossbar add game:time/endgame_timer {"translate":"game.endgame_timer", "color":"gold"}
bossbar set game:time/endgame_timer style notched_6
bossbar set game:time/endgame_timer visible true
bossbar set game:time/endgame_timer color red
bossbar set game:time/endgame_timer max 600