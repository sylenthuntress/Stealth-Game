class TextBuilder:
    ## This becomes "text", or the translation key if using translate()
    def __init__(self, string):
        self._string = string
        self._bold = false
        self._italic = false
        self._color = "white"
        self._with = []
        self._hover_event = {}
        self._translate = false

    def color(self, color: str):
        self._color = color
        return self
    
    def bold(self):
        self._bold = true
        return self

    def italic(self):
        self._italic = true
        return self

    def translated(self):
        self._translate = true
        return self
    
    def translate(self, translation):
        translation = {self._string: translation}
        merge language hide_and_squeak:en_us {**translation}
        return self.translated()

    def with_text(self, text):
        self._with.append(text)
        return self

    def hover_text(self, *text):
        self._hover_event = {"action": "show_text", "value": text}

    def build(self):
        string = {"text": self._string}
        if self._translate:
            string = {"translate": self._string}

        text = {
            **string,
            "color": self._color,
            "bold": self._bold,
            "italic": self._italic,
            "with": self._with
        }

        if self._hover_event:
            text.update({"hover_event": self._hover_event})
        return text