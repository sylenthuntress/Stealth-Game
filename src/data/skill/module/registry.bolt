# Old code

id_index = 0
def register(icon, atlas):
    global id_index
    id_index += 1
    return {"id": id_index, "icon": icon, "atlas": atlas, "isRandom": 0}

def registerRandom():
    global id_index
    id_index += 1
    return {"id": id_index, "icon": "hide_and_squeak:item/random", "atlas": "minecraft:items", "isRandom": 1}

