id_index = 0
def register(icon, atlas):
    global id_index
    id_index += 1
    return {"id": id_index, "icon": icon, "atlas": atlas}

runner_skills = {
    "camoflauge": register("minecraft:block/bush", "minecraft:blocks"),
    "brawler": register("minecraft:mob_effect/strength", "minecraft:gui"),
    "tank": register("minecraft:mob_effect/resistance", "minecraft:gui"),
    "jumper": register("minecraft:mob_effect/jump_boost", "minecraft:gui"),
    "medic": register("minecraft:mob_effect/regeneration", "minecraft:gui"),
    "puppeteer": register("minecraft:mob_effect/infested", "minecraft:gui"),
    "warper": register("minecraft:item/clock_00", "minecraft:items"),
    "ender": register("minecraft:item/ender_pearl", "minecraft:items"),
    "distorter": register("minecraft:block/warped_fungus", "minecraft:blocks"),
    "chemist": register("minecraft:block/brewing_stand", "minecraft:blocks"),
    "doctor": register("minecraft:item/apple", "minecraft:items"),
    "random": register("minecraft:item/nether_star", "minecraft:items")
}

killer_skills = {
    "athlete": register("minecraft:mob_effect/speed", "minecraft:gui"),
    "acrobat": register("minecraft:mob_effect/jump_boost", "minecraft:gui"),
    "winged": register("minecraft:item/elytra", "minecraft:items"),
    "trapper": register("minecraft:block/tripwire_hook", "minecraft:blocks"),
    "witch": register("minecraft:item/witch_spawn_egg", "minecraft:items"),
    "locator": register("minecraft:item/compass_00", "minecraft:items"),
    "specter": register("minecraft:mob_effect/invisibility", "minecraft:gui"),
    "shifter": register("minecraft:block/lapis_ore", "minecraft:blocks"),
    "gemini": register("minecraft:mob_effect/oozing", "minecraft:gui"),
    "random": register("minecraft:item/nether_star", "minecraft:items")
}

weapons = {
    "trident": register("minecraft:item/trident", "minecraft:items"),
    "spectral_bow": register("minecraft:item/bow", "minecraft:items"),
    "crossbow": register("minecraft:item/crossbow_arrow", "minecraft:items"),
    "mace": register("minecraft:item/mace", "minecraft:items"),
    "random": register("minecraft:item/nether_star", "minecraft:items")
}

runner_prefix = "skill.runner."
killer_prefix = "skill.killer."
weapon_prefix = "skill.weapon."

def getRunnerSkills():
    keys = []
    for key in runner_skills.keys():
        keys.append(runner_prefix + key)
    return keys

def getKillerSkills():
    keys = []
    for key in killer_skills.keys():
        keys.append(killer_prefix + key)
    return keys

def getWeapons():
    keys = []
    for key in weapons.keys():
        keys.append(weapon_prefix + key)
    return keys