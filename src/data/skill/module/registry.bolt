numid_index = 0
class SkillBuilder():
    def __init__(self, identifier, registry):
        self._identifier = identifier
        global numid_index
        numid_index += 1
        self._numid = numid_index
        self._desc = {"translate": identifier+".desc"}
        self._type = registry
        self._icon = {"sprite": "minecraft:item/barrier", "atlas": "minecraft:items"}
        self._predicate = {}
        self._components = {}

    def desc(self, text):
        self._desc = text
        return self

    def icon(self, sprite, atlas):
        self._icon = {"sprite": sprite, "atlas": atlas}
        return self

    def is_random(self):
        self._components.update({"skill:random": true})
        return self

    def exclude_random(self):
        self._components.update({"skill:exclude_random": true})
        return self

    def team_only(self, team_size):
        self._components.update({"skill:team_only": team_size})
        return self

    def default(self):
        self._components.update({"skill:default": true})
        return self

    def predicate(self, predicate):
        self._predicate = predicate
        return self

    def build(self):
        nbt = {
            "type": self._type,
            "id": self._identifier,
            "numid": self._numid,
            "trigger": "trigger skill.selection set " + str(self._numid),
            "desc": self._desc,
            "icon": self._icon,
            "components": self._components
        }
        append function setup:skills:
            data modify storage skill:data Registry append value nbt
        return nbt
    

# Runner Skills
def runner(name):
    name = "skill.runner." + name
    return SkillBuilder(name, "skill:runner")

runners = [
    runner("camouflage")
        .icon("minecraft:block/bush", "minecraft:blocks")
        .build(),
    runner("brawler")
        .icon("minecraft:mob_effect/strength", "minecraft:gui")
        .build(),
    runner("jumper")
        .icon("minecraft:mob_effect/jump_boost", "minecraft:gui")
        .build(),
    runner("medic")
        .icon("minecraft:mob_effect/regeneration", "minecraft:gui")
        .team_only(2)
        .build(),
    runner("undying")
        .icon("minecraft:item/totem_of_undying", "minecraft:items") 
        .build(),
    runner("puppeteer")
        .icon("hide_and_squeak:item/small_puppet", "minecraft:items")
        .build(),
    runner("warper")
        .icon("hide_and_squeak:item/warp", "minecraft:items")
        .build(),
    runner("alchemist")
        .icon("hide_and_squeak:item/alchemist", "minecraft:items")
        .build(),
    runner("random")
        .icon("hide_and_squeak:item/random", "minecraft:items")
        .is_random()
        .build()
]

