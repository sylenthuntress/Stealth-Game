runner_prefix = "skill.runner."
killer_prefix = "skill.killer."
weapon_prefix = "skill.weapon."

def getRunnerSkills():
    skills = []
    for key in runner_skills.keys():
        skills.append(runner_prefix + key)
    return skills

def getKillerSkills():
    skills = []
    for key in killer_skills.keys():
        skills.append(killer_prefix + key)
    return skills

def getWeapons():
    skills = []
    for key in weapons.keys():
        skills.append(weapon_prefix + key)
    return skills

def getFunctions():
    skills = []
    for key in runner_skills.keys():
        skills.append({"tag": runner_prefix + key, "path": "skill:runner_skill/" + key + "/"})
    for key in weapons.keys():
        skills.append({"tag": weapon_prefix + key, "path": "skill:weapon/" + key + "/"})
    for key in killer_skills.keys():
        skills.append({"tag": killer_prefix + key, "path": "skill:killer_skill/" + key + "/"})
    return skills