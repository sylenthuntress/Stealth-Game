def register(weight, biome, canBeLarge, canBeMed, canBeSmall):
    return {"weight": weight, "biome": biome, "canBeLarge": canBeLarge, "canBeMed": canBeMed, "canBeSmall": canBeSmall}
def registerUniversal(weight):
    return register(weight, "minecraft:the_void", 1, 1, 1)
def registerBiome(weight, biome):
    return register(weight, biome, 1, 1, 1)

segments = {
    "test": registerUniversal(0),
    "dappled_trees": registerBiome(10, "minecraft:dappled_forest"),
    "birch_trees": registerBiome(10, "minecraft:birch_forest"),
    "desert": register(10, "minecraft:desert", 1, 1, 0),
#    "spores_cave": register(0, "minecraft:lush_caves", 0, 0, 1),
    "spores_field": registerBiome(10, "minecraft:lush_caves"),
    "skull_peak": registerBiome(10, "minecraft:warm_ocean"),
    "trial_chambers": registerUniversal(10)
}

bands = {
    "test": registerUniversal(0),
    "crimson": registerUniversal(5),
    "end": registerUniversal(5),
    "warped": registerUniversal(5)
}

segment_prefix = "level:segment/"
band_prefix = "level:band/"

def getSegments():
    keys = []
    for key in segments.keys():
        keys.append(segment_prefix + key)
    return keys

def getBands():
    keys = []
    for key in bands.keys():
        keys.append(band_prefix + key)
    return keys