def register(weight, canBeLarge, canBeMed, canBeSmall):
    return {"weight": weight, "canBeLarge": canBeLarge, "canBeMed": canBeMed, "canBeSmall": canBeSmall}
def registerUniversal(weight):
    return register(weight, 1, 1, 1)

segments = {
    "test": registerUniversal(1)
}

bands = {
    "test": registerUniversal(1)
}

segment_prefix = "level:segment/"
band_prefix = "level:band/"

def getSegments():
    keys = []
    for key in segments.keys():
        keys.append(segment_prefix + key)
    return keys

def getBands():
    keys = []
    for key in bands.keys():
        keys.append(band_prefix + key)
    return keys